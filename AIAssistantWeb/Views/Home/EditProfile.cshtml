@model AIAssistant.Core.Models.AssistantProfile

@{
    ViewData["Title"] = "Edit Assistant";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <h1 class="fw-bold mb-4">
                        Edit Assistant
                    </h1>

                    <p class="text-muted mb-4">
                        Update your AI assistant configuration and behavior.
                    </p>

                    <form method="post">

                        <input type="hidden"
                               name="originalName"
                               value="@Model.Name" />

                        <!-- NAME -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Assistant Name
                            </label>

                            <input type="text"
                                   name="name"
                                   value="@Model.Name"
                                   class="form-control form-control-lg"
                                   required />

                        </div>

                        <!-- PROMPT -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                System Prompt
                            </label>

                            <textarea name="systemPrompt"
                                      rows="5"
                                      class="form-control">@Model.SystemPrompt</textarea>

                        </div>

                        <!-- TEMPERATURE -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Temperature
                            </label>

                            <input type="number"
                                   step="0.1"
                                   min="0"
                                   max="1"
                                   name="temperature"
                                   value="@Model.Temperature"
                                   class="form-control form-control-lg" />

                            <div class="form-text">
                                Lower values = more precise answers.
                                Higher values = more creative answers.
                            </div>

                        </div>

                        <!-- STRATEGY -->
                        <div class="mb-5">

                            <label class="form-label fw-semibold">
                                Response Strategy
                            </label>

                            <select name="strategy"
                                    class="form-select form-select-lg">

                                <option value="formal">
                                    Formal Assistant
                                </option>

                                <option value="friendly">
                                    Friendly Assistant
                                </option>

                            </select>

                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex gap-3">

                            <button type="submit"
                                    class="btn btn-success btn-lg px-4">

                                Save Changes

                            </button>

                            <a asp-controller="Home"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary btn-lg px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>